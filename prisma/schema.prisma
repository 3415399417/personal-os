// BetterLife Personal OS — 数据模型（按规格书 §8 核心数据模型）
// SQLite + Prisma；字段命名与规格书一致（snake_case）

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── 项目 ──
model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  status      String   @default("active") // active | paused | completed | archived
  progress    Int      @default(0) // 冗余字段：= 完成任务数/总任务数，写操作时同步更新
  priority    Int      @default(3) // 1 最高 → 5 最低
  folderPath  String   @default("") // 项目所在文件夹路径（本地磁盘，可点击打开）
  isTodayFocus Boolean @default(false) // 今日焦点（与任务焦点互斥，全局唯一）
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
  notes       Note[]
  resources   Resource[]
  assets      Asset[]
  conversations AiConversation[]
  frictionLogs FrictionLog[]
}

// ── 任务 ──
model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  status      String    @default("todo") // todo | doing | waiting | completed
  group       String    @default("must") // 分组（创建时确定，完成不移组）：must | doing | waiting | done
  priority    Int       @default(3)
  projectId   String?
  isTodayFocus Boolean  @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  artifacts   String    @default("[]") // JSON：[{type: file|folder|glob, path|pattern}]，进度感知用
  readyForConfirm Boolean @default(false) // 全部预期产物已就位，等用户确认完成

  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  progressEvents ProgressEvent[]
  frictionLogs   FrictionLog[]
}

// ── 进度事件（完成依据时间线：文件命中 / 状态变化 / 确认完成） ──
model ProgressEvent {
  id        String   @id @default(cuid())
  taskId    String
  projectId String?
  type      String   @default("artifact_matched") // artifact_matched | status_changed | confirmed | manual
  detail    String   @default("")
  path      String   @default("")
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ── 通知（系统自动事件汇总：待办过期/提醒到点/项目完成/备份/AI 日报/GitHub 情报） ──
model Notification {
  id        String   @id @default(cuid())
  type      String   @default("system") // todo_overdue(动态不存) | reminder_due | project_done | backup_done | report_ready | github_update
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── GitHub 情报检测快照（对比上次拉取，发现新增写通知） ──
model GithubCheck {
  id        String   @id @default("last")
  hotIds    String   @default("[]") // 热门仓库 id JSON
  newsIds   String   @default("[]") // 技术新闻 id JSON
  updatedAt DateTime @updatedAt
}

// ── 学习时长（系统使用计时：打开 personal-os 即计时，关闭停止，按天累加） ──
model DailyUsage {
  id          String    @id @default(cuid())
  date        String    @unique // YYYY-MM-DD
  seconds     Int       @default(0)
  lastTickAt  DateTime? // 最近一次心跳，用于去重与兜底结算
  updatedAt   DateTime  @updatedAt
}

// ── 摩擦日志（任务执行卡点/踩坑记录，喂给复盘） ──
model FrictionLog {
  id        String   @id @default(cuid())
  content   String
  taskId    String?
  projectId String?
  createdAt DateTime @default(now())

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ── 笔记 ──
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  type      String   @default("note") // note | document | prompt | learning | idea
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ── 资源 ──
model Resource {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("inbox") // inbox | domain | project | learning | knowledge | command | template
  description String   @default("")
  url         String   @default("")
  status      String   @default("open") // open | handled（收集箱条目标记已处理）
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ── 提醒 ──
model Reminder {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  remindAt  DateTime?
  status    String   @default("pending") // pending | done
  createdAt DateTime @default(now())
}

// ── 学习记录 ──
model LearningRecord {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  progress  Int      @default(0) // 0-100
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── 个人资料（单行，id 固定 "main"）：姓名/身份/焦点/头像，存数据库 → 换浏览器不丢 ──
model Profile {
  id      String  @id @default("main")
  name    String  @default("")
  role    String  @default("外贸创业者")
  focus   String  @default("外贸AI系统搭建")
  avatar  String  @default("")
  updatedAt DateTime @updatedAt
}

// ── 长期资产 ──
model Asset {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("sop") // sop | prompt | skill | project_memory | review
  content   String   @default("")
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ── 复盘 ──
model Review {
  id           String   @id @default(cuid())
  title        String   @default("") // 复盘标题（项目总结=项目名+时间；日报/周报=周期复盘；空则显示层回退 period）
  period       String   @default("")
  summary      String   @default("")
  problems     String   @default("")
  achievements String   @default("")
  nextPlan     String   @default("")
  createdAt    DateTime @default(now())
}

// ── AI 会话 ──
model AiConversation {
  id          String   @id @default(cuid())
  title       String   @default("新对话")
  contextType String   @default("page") // project | page
  contextId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    AiMessage[]
  project     Project? @relation(fields: [contextId], references: [id], onDelete: SetNull)
}

// ── AI 消息 ──
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String         @default("user") // user | assistant | system
  content        String         @default("")
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
